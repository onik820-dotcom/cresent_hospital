# Copy to deploy/.env on the VPS (chmod 600). NEVER commit the real file.

# ---- LiveKit (self-hosted: make up any key/secret pair; the secret must be 32+ random characters) ----
#   openssl rand -hex 16   -> key name suffix      openssl rand -hex 32 -> secret
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Supabase agent-tools API (Lovable app > Settings > API Tester shows the URL and key) ----
AGENT_API_BASE=https://vkhpzupnxwotvwjnznuu.supabase.co/functions/v1
AGENT_API_KEY=

# ---- Gemini (PAID tier only for real calls; free tier may train on patient audio) ----
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_LANGUAGE=
SUMMARY_MODEL=gemini-3.5-flash-lite

# ---- Server ----
VOICE_DOMAIN=voice.example.com      # DNS A record -> this VPS
PUBLIC_IP=                          # this VPS's public IPv4

# ---- IPTSP SIP account (from the provider) ----
IPTSP_HOST=
IPTSP_PORT=5060
IPTSP_USER=
IPTSP_PASSWORD=
IPTSP_ALLOWED_IP=                   # provider's SIP IP or CIDR; defaults to IPTSP_HOST
CALLED_NUMBER=09611132581           # the hotline as LiveKit should see it. Leave empty to use what the IPTSP sends
INBOUND_NUMBERS=09611132581         # used by scripts/setup_sip.py (comma separated, empty = accept any)
OUTBOUND_PREFIX=0                   # +8801XXXXXXXXX is dialled as 01XXXXXXXXX; set to "" if your IPTSP wants 8801...

# ---- Transfer / fallback ----
FALLBACK_TRANSFER_NUMBER=           # where unserved calls go (e.g. hospital main line); +880... or 01...

# ---- Cost model (USD per 1M tokens). PLACEHOLDERS: set from the current Gemini pricing page ----
COST_IN_AUDIO_PER_MTOK=3.33
COST_OUT_AUDIO_PER_MTOK=12.0
COST_IN_TEXT_PER_MTOK=0.75
COST_OUT_TEXT_PER_MTOK=4.5
